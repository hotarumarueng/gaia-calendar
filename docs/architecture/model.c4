// gaia-calendar アーキテクチャモデル（LikeC4）
// プレビュー: npx likec4 start docs/architecture

specification {
  element person {
    style {
      shape person
    }
  }
  element system
  element container
  element database {
    style {
      shape storage
    }
  }
}

model {
  member = person 'グループメンバー' {
    description '定例会に集まりたい社会人（数人〜10人）。ログイン不要'
  }

  slack = system 'Slack' {
    description '毎週の入力促しとURL共有（手動運用・システム外）'
    style {
      color muted
    }
  }

  gaia = system 'gaia-calendar' {
    description '常設の日程調整マトリクス表'

    web = container 'Next.js アプリ' {
      description 'マトリクス表示（Server Component）と入力フォーム（Client Component）'
      technology 'Next.js App Router / Vercel 無料枠'
    }

    api = container 'API Routes /api/entries' {
      description '人単位の upsert / delete。整合性ルール（trim・空配列=削除）を集約する唯一の変更窓口'
      technology 'Next.js Route Handlers'
    }

    db = database 'Amazon DynamoDB' {
      description 'シングルテーブル gaia-calendar。Member item（コメント）+ Preference item（人×時間帯の希望曜日）。専用IAMユーザーの最小権限でアクセス'
      technology 'DynamoDB / Always Free（25RCU/25WCU）'
    }

    web -> api 'POST / DELETE（保存・削除）'
    web -> db '表データの読み取り（Server Component から lib/db 経由）'
    api -> db 'PutItem / DeleteItem（AWS認証情報はサーバー専用）'
  }

  member -> gaia.web '閲覧・希望入力・コメント'
  slack -> member '毎週URLを共有して入力を促す'
}

views {
  view index {
    title 'gaia-calendar 全体像（Context）'
    include *
  }

  view containers of gaia {
    title 'コンテナ構成（Container）'
    include *, member
  }
}
